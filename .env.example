# Nơi lưu video: cloudinary | google-drive
NEXT_PUBLIC_STORAGE_PROVIDER=cloudinary

# Cloudinary (unsigned upload — an toàn để public ở frontend)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Google Drive (PHASE SAU — chỉ dùng ở server, KHÔNG đặt tiền tố NEXT_PUBLIC_)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_DRIVE_FOLDER_ID=
